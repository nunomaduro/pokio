{
    "name": "nunomaduro/pokio",
    "description": "Pokio is a dead simple asynchronous API for PHP that just works",
    "keywords": ["pokio","php", "asynchronous", "library"],
    "license": "MIT",
    "authors": [
        {
            "name": "Nuno Maduro",
            "email": "enunomaduro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "nunomaduro/pao": "^1.1.5",
        "peckphp/peck": "^0.1.3 || ^0.3.0",
        "pestphp/pest": "^4.7.5 || ^5.3.5",
        "pestphp/pest-plugin-type-coverage": "^4.0.3 || ^5.1.0",
        "phpstan/phpstan": "^2.3.5",
        "symfony/var-dumper": "^7.4.8 || ^8.1.10"
    },
    "conflict": {
        "symplify/easy-parallel": "<11.2.2"
    },
    "autoload": {
        "psr-4": {
            "Pokio\\": "src/"
        },
        "files": [
            "src/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": [
            "pint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:typos": "peck",
        "test:lint": [
            "pint --test"
        ],
        "test:unit": "pest --parallel --coverage --min=89.6",
        "test:types": "phpstan",
        "test": [
            "@test:lint",
            "@test:type-coverage",
            "@test:typos",
            "@test:types",
            "@test:unit"
        ]
    }
}
